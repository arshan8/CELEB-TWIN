#CNN

import numpy as np
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, LSTM, Dense, Conv1D, GlobalMaxPooling1D
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
from sklearn.metrics import classification_report, confusion_matrix, ConfusionMatrixDisplay
import matplotlib.pyplot as plt

# Sample data
comments = ["bad", "very", "amazing", "worst", "not", "excellent", "sucks", "loved"]
labels = ["shit", "good", "life", "game", "bad", "job", "girl", "her"]  

# Tokenize X
tokenizer_x = Tokenizer()
tokenizer_x.fit_on_texts(comments)
X = pad_sequences(tokenizer_x.texts_to_sequences(comments), padding='post')

# Tokenize y
tokenizer_y = Tokenizer()
tokenizer_y.fit_on_texts(labels)
y = np.array([s[0] for s in tokenizer_y.texts_to_sequences(labels)])

# Define CNN model
vocab_size_x = len(tokenizer_x.word_index) + 1
vocab_size_y = len(tokenizer_y.word_index) + 1

model = Sequential([
    Embedding(vocab_size_x, 8, input_length=X.shape[1]),
    Conv1D(16, 3, activation='relu', padding='same'),  # 1D conv over text
    GlobalMaxPooling1D(),                 
    Dense(vocab_size_y, activation='softmax')
])

model.compile(loss='sparse_categorical_crossentropy', optimizer='adam', metrics=['accuracy'])

# Train
model.fit(X, y, epochs=50, verbose=0)

# Predict
pred_idx = model.predict(X, verbose=0).argmax(axis=1)

# Map back to words
inv_map = {v:k for k,v in tokenizer_y.word_index.items()}
pred_words = [inv_map[i] for i in pred_idx]
print("Predicted labels:", pred_words)

# Classification report & confusion matrix
print("\nClassification Report:\n")
print(classification_report(y, pred_idx, target_names=list(tokenizer_y.word_index.keys())))

cm = confusion_matrix(y, pred_idx)
disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=list(tokenizer_y.word_index.keys()))
disp.plot(cmap="Blues", values_format="d")
plt.show()






