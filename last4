import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense
from sklearn.metrics import classification_report, ConfusionMatrixDisplay
import matplotlib.pyplot as plt


# Generate sine wave
x = np.linspace(0, 100, 1000)
y = np.sin(x) + 0.1 * np.random.randn(len(x))

# Prepare sequences
window = 20
X, Y = [], []
for i in range(len(y) - window):
    X.append(y[i:i+window])
    Y.append(y[i+window])
X, Y = np.array(X), np.array(Y)
X = X.reshape((X.shape[0], X.shape[1], 1))

# Train/test split
split = int(0.8 * len(X))
X_train, Y_train = X[:split], Y[:split]
X_test, Y_test = X[split:], Y[split:]

# Model
model = Sequential([
    LSTM(50, activation='tanh', input_shape=(window, 1)),
    Dense(1)
])
model.compile(optimizer='adam', loss='mse')
model.fit(X_train, Y_train, epochs=20, verbose=0)

# Predict
Y_pred = model.predict(X_test)

# Plot actual vs predicted sine wave
plt.figure(figsize=(10,5))
plt.plot(range(len(Y_test)), Y_test, label="Actual", color="blue")
plt.plot(range(len(Y_pred)), Y_pred, label="Predicted", color="red")
plt.title("Sine Wave Prediction (LSTM)")
plt.legend()
plt.show()


y_true_cls = np.array([0, 1, 1, 0, 1, 0, 1, 1, 0, 1])

# Fake predictions (not perfect, some errors)
y_pred_cls = np.array([0, 1, 0, 0, 1, 0, 1, 0, 1, 1])

# Classification Report
print(classification_report(y_true_cls, y_pred_cls))

# Confusion Matrix
ConfusionMatrixDisplay.from_predictions(y_true_cls, y_pred_cls, cmap="Blues")
plt.title("Confusion Matrix (Simulated)")
plt.show()


















